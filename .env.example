# =============================================================================
# IntelliProcess AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Stage (dev | prod)
STAGE=dev

# S3
DOCUMENT_BUCKET=intelliprocess-docs-dev-123456789012

# DynamoDB Tables
INVOICE_TABLE=IntelliProcess-Invoices-dev
PO_TABLE=IntelliProcess-PurchaseOrders-dev
GR_TABLE=IntelliProcess-GoodsReceipts-dev
CONVERSATION_TABLE=IntelliProcess-Conversations-dev
DOCUMENT_TABLE=IntelliProcess-Documents-dev

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
KNOWLEDGE_BASE_ID=PLACEHOLDER
GUARDRAIL_ID=PLACEHOLDER

# Bedrock Data Automation
BDA_PROJECT_ARN=arn:aws:bedrock:us-east-1:123456789012:data-automation-project/PLACEHOLDER

# Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend (used by React via VITE_ prefix)
VITE_API_URL=http://localhost:8000
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# S3 Vectors (index name or ARN for vector search)
S3_VECTORS_INDEX=

# Strands Agent Configuration
STRANDS_MAX_TOKENS=4096
STRANDS_TEMPERATURE=0.0

# Logging
LOG_LEVEL=INFO
